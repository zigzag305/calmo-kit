# Optional: Connect Calmo Kit to your shared Supabase project's Edge Functions
# IMPORTANT: Calmo Kit ONLY calls `calmo-create-checkout` and `calmo-submit-lead`
# writing to isolated `calmo_kit_orders` and `calmo_kit_leads` tables.
# It NEVER uses Supabase Auth / login or touches Cuyo Marketing tables.

VITE_CALMO_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_CALMO_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
